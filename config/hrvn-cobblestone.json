{
	"crs": {
		"input": "EPSG:4326",
		"metric": "EPSG:31256",
		"output": "EPSG:4326"
	},
	"paths": {
		"work_dir": "work/hrvn-cobblestone",
		"output_dir": "dist/hrvn-cobblestone",
		"hrvn_cobblestone_geojson": "dist/hrvn-cobblestone/hrvn_cobblestone.geojson",
		"hrvn_cobblestone_fgb": "dist/hrvn-cobblestone/hrvn_cobblestone.fgb",
		"debug_all_cobblestone_geojson": "dist/hrvn-cobblestone/debug_sis_cobblestone_merged.geojson",
		"debug_all_cobblestone_fgb": "dist/hrvn-cobblestone/debug_sis_cobblestone_merged.fgb",
		"debug_hrvn_corridor_geojson": "dist/hrvn-cobblestone/debug_hrvn_corridor.geojson",
		"summary": "dist/hrvn-cobblestone/summary.json"
	},
	"sources": {
		"hrvn": {
			"url": "https://data.wien.gv.at/daten/geo?service=WFS&request=GetFeature&version=1.1.0&typeName=ogdwien:RADNETZOGD&srsName=EPSG:4326&outputFormat=json",
			"filter_property": "M18_RANG_SUB",
			"filter_values": ["B", "G", "E"]
		},
		"sis": {
			"base_url": "https://data.wien.gv.at/daten/geo",
			"version": "1.1.0",
			"type_name": "ogdwien:SISBELAGOGD",
			"output_format": "json",
			"filter_property": "TYPE",
			"filter_values": ["GM", "GO", "KL"],
			"server_filter": true
		}
	},
	"analysis": {
		"buffer_m": 15.0
	},
	"download": {
		"tile_size_m": 2000.0,
		"timeout_s": 180,
		"retries": 5,
		"retry_backoff_s": 1.0,
		"delay_between_requests_s": 0.1,
		"max_response_mb": 512
	},
	"output": {
		"simplify_tolerance_m": 0.2,
		"debug_simplify_tolerance_m": 0.2
	}
}
